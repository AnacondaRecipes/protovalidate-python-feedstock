From 4ccca9b6b9d7c18cdf081c125d4d07a81214e6b0 Mon Sep 17 00:00:00 2001
From: Mikolaj Gralczyk <mgralczyk@anaconda.com>
Date: Wed, 17 Dec 2025 13:35:54 +0100
Subject: [PATCH] Include gen/buf to the build

This patch fixes ModuleNotFoundError: 'buf' and 'cel'
---
 pyproject.toml | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/pyproject.toml b/pyproject.toml
index 9e78f3a..280b446 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -56,6 +56,9 @@ resolution = "lowest-direct"
 source = "vcs"
 raw-options = { fallback_version = "0.0.0" }
 
+[tool.hatch.build.targets.wheel]
+packages = ["protovalidate", "gen/buf", "gen/cel"]
+
 [tool.ruff]
 line-length = 120
 lint.select = [
